# Slack (Socket Mode) — only needed for `npm start`
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Claude API — required for both `npm run dev` and `npm start`
ANTHROPIC_API_KEY=sk-ant-your-key

# Postgres — optional. If unset, notes + conversation memory fall back to
# local files / in-process storage with a logged warning.
DATABASE_URL=postgresql://user:password@localhost:5432/assistant

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_ITERATIONS=8
ASSISTANT_DATA_DIR=~/.agentic-workflow-assistant
